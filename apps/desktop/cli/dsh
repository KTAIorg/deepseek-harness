#!/bin/sh
# Run the installed CLI without changing the invoking shell or working directory.
set -e
launcher=$0
while [ -L "$launcher" ]; do
  directory=$(CDPATH= cd -- "$(dirname -- "$launcher")" && pwd -P)
  target=$(readlink "$launcher")
  case "$target" in
    /*) launcher=$target ;;
    *) launcher=$directory/$target ;;
  esac
done
resources=$(CDPATH= cd -- "$(dirname -- "$launcher")/../../.." && pwd -P)
# An inherited DSH_HOME names a DeepSeek Harness home; this command uses the Kito Harness one.
DSH_HOME=${KITO_HARNESS_HOME:-$HOME/.kito-harness}
export DSH_HOME
ELECTRON_RUN_AS_NODE=1 exec "$resources/../MacOS/Kito Harness" --expose-internals "$resources/app.asar/dsh/node_modules/@deepseek-ai/dsh-desktop-host/lib/cli.js" "$@"
